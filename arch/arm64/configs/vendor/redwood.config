# Redwood build config
CONFIG_MACH_XIAOMI_REDWOOD=y

# Charger
CONFIG_AI_RSOC=y
CONFIG_BQ_CLOUD_AUTHENTICATION=y
CONFIG_BQ_FG_1S=y
CONFIG_BQ_FUEL_GAUGE=y
CONFIG_BQ2597X_BATTERY_CHARGER=y

# Fingerprint
CONFIG_GOODIX_FINGERPRINT=y
CONFIG_XIAOMI_FINGERPRINT=y

# Disable mmc driver
# CONFIG_MMC is not set

# Disable fsa4480 (Redwood doesn't support usb audio)
CONFIG_AUDIT=y

# Haptics
# CONFIG_INPUT_QCOM_HV_HAPTICS is not set
CONFIG_INPUT_AW86927_HAPTIC=y

# IO Schedulers
CONFIG_CFQ_GROUP_IOSCHED=y

# IR
CONFIG_IR_SPI=y
CONFIG_LIRC=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y

# Pinctrl
CONFIG_PINCTRL_SM7325=y
CONFIG_PINCTRL_REDWOOD=y

# Touchscreen
CONFIG_TOUCHSCREEN_GOODIX_BRL_9916=y
CONFIG_TOUCHSCREEN_QGKI_GOODIX=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_FOCALTECH_3680=y

# File systems
CONFIG_EXFAT_FS=y

# Hardware ID
CONFIG_MI_HARDWARE_ID=y

# RCU Subsystem
CONFIG_BLK_CGROUP=y

CONFIG_PM_SLEEP_DEBUG=y
CONFIG_SUSPEND_SKIP_SYNC=y

CONFIG_LOG_BUF_SHIFT=20
CONFIG_LOG_CPU_MAX_BUF_SHIFT=20

